# Modèle de configuration — copier en .env (ignoré par git) et compléter.
# Aucune de ces variables n'est requise : sans elles, l'application tourne en
# mode local pur, et le sous-onglet Projet reste utilisable via ses formulaires.

# ─── Supabase (synchronisation optionnelle) ──────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Origines autorisées à appeler /api/* depuis un navigateur ───────────────
# Liste séparée par des virgules. VERCEL_URL est acceptée automatiquement.
ALLOWED_ORIGINS=

# ─── Assistant Horizon (sous-onglet Projet) ──────────────────────────────────
# Chaîne de repli, dans cet ordre : Gemini → Groq → Ollama → mode dégradé.
# Le mode dégradé n'est pas une panne : les formulaires produisent exactement
# les mêmes calculs, seule la question en langage naturel disparaît.
#
# AUCUN FOURNISSEUR PAYANT n'est joignable : il n'existe pas d'adaptateur
# Claude, OpenAI ou équivalent dans le code. Renseigner une clé de ce type
# ici n'aurait aucun effet — la contrainte est structurelle, pas configurable.
#
# Ces variables sont lues UNIQUEMENT côté serveur (api/advisor.js). Ne jamais
# les préfixer par VITE_, ce qui les embarquerait dans le bundle client.

# Google Gemini — fournisseur par défaut (free tier).
# Clé : https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Groq — premier repli (free tier, modèles ouverts).
# Clé : https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama — repli local, sans quota. Dans ce mode, aucune donnée ne quitte la
# machine : la promesse de confidentialité de Patrium reste littéralement vraie.
# Laisser vide pour désactiver. Exemple : http://127.0.0.1:11434
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:7b

# ─── Calendrier financier : source SEC EDGAR (optionnelle) ───────────────────
# Les dépôts réglementaires américains (10-K, 10-Q, 8-K, DEF 14A) complètent
# Yahoo pour les lignes US : ils apportent les communiqués, et surtout ils
# CONFIRMENT une date que Yahoo ne fait qu'estimer.
#
# L'API est publique, gratuite et sans clé, mais la SEC exige un en-tête
# User-Agent nominatif comportant un moyen de contact — sans lui elle répond
# 403. Format attendu : "NomDeLApp contact@domaine.fr".
#
# Absente ⇒ la source reste simplement éteinte, le calendrier continue de
# fonctionner avec Yahoo seul. Aucune dégradation visible à part les
# communiqués 8-K, qui n'existent pas chez Yahoo.
SEC_USER_AGENT=
